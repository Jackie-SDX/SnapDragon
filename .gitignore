# Local engineering scratch space (never commit test fixtures, nested repos,
# or generated target workspaces from here)
.octmp/
.oc-tmp/

# Node tooling
node_modules/
npm-debug.log*
yarn-error.log*

# Behavioral evaluation artifacts (generated by run-agent-evals.sh and
# uploaded as workflow artifacts; never source).
agent-eval-summary.json
agent-eval-results.jsonl

# OS / editor noise
.DS_Store
Thumbs.db
