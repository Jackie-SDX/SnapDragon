    "ffmpeg-static": "^5.2.0",
    "groq-sdk": "^0.9.0",
    "mongoose": "^8.2.0",
    "pino": "^8.19.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "eslint": "9.39.5"
  }
