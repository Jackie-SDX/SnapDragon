{
  "name": "whatsapp-vibe-moderator",
  "version": "2.4.0",
  "description": "Fun, robust WhatsApp moderator bot powered by Gemini AI and Baileys with separate pairing & keeping-alive",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node scripts/test-simple-web-crawler.js && node scripts/test-agent-invariants.js",
