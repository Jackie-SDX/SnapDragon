# Copy this file to keystore.properties (same folder, no ".example") and
# fill in real values. keystore.properties is gitignored — never commit
# your actual keystore password or key password.
#
# See the README's "Release signing" section for the exact keytool
# command that creates the .jks file this points to.

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=threeseeds
keyPassword=CHANGE_ME
